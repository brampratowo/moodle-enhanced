# Moodle
MOODLE_SERIES=501
# MOODLE_DOWNLOAD_URL=  # opsional, override URL paket resmi (packaging.moodle.org)
APP_PORT=8080
APP_HOST=localhost

# MariaDB
DB_HOST=moodle-db
DB_PORT=3306
DB_TYPE=mariadb
DB_PREFIX=mdl_
PERMISSION_MODE=compat
WWW_DATA_UID=33
WWW_DATA_GID=33

# Sandi root MariaDB (hanya untuk container db; Moodle memakai DB_* di bawah)
MYSQL_ROOT_PASSWORD=ubah-sandi-root-mariadb

# Database aplikasi Moodle = inisialisasi MariaDB (harus sama di config.php / wizard)
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=ubah-sandi-database

# Redis (sesi Moodle di config.php)
REDIS_HOST=moodle-redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PREFIX=sess_

# MinIO (jika memakai docker-compose-minio.yml)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=ubah-sandi-minio

# Host mount paths (relative to folder moodle-raw-install)
MOODLE_SOURCE_PATH=./moodle
MOODLEDATA_PATH=./moodledata
MOODLE_CONFIG_PATH=./moodle/config.php
# MOODLE_CONFIG_SKIP_SYNC=1  # jangan timpa config.php saat ./scripts/install.sh

# Jaringan bersama compose (script default docker_network jika tidak di-set)
# DOCKER_NETWORK_NAME=docker_network

# Beberapa berkas compose (pemisah titik dua). Harus sama dengan stack yang di-install
# agar scripts/up.sh, down.sh, logs.sh tepat. Contoh full stack:
# INSTALL_COMPOSE_FILES=docker-compose-moodle.yml:docker-compose-mariadb.yml:docker-compose-redis.yml
